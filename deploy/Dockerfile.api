# syntax=docker/dockerfile:1
# linux/amd64 and linux/arm64. Built on the VM, so Oracle ARM produces an arm64 image.

FROM python:3.12-slim-bookworm AS packages

# torch.compile (Docling layout) asks Inductor for g++. The official Python
# image already has Python.h; g++ is the Debian package name on amd64 and arm64.
#
# Prod Postgres is pgvector/pgvector:pg16. Bookworm's postgresql-client is 15,
# and pg_dump aborts on a newer server. The PGDG client is pinned to major 16
# and placed first on PATH so the migrate service cannot pick the Debian 15
# tools.
ENV PATH="/usr/lib/postgresql/16/bin:${PATH}"
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        g++ \
        libgomp1 \
        libglib2.0-0 \
        libgl1 \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
        https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-16 \
    && rm -rf /var/lib/apt/lists/* \
    && version="$(pg_dump --version)" \
    && echo "$version" \
    && echo "$version" | grep -q 'PostgreSQL) 16[.]'

FROM packages

COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/backend/.venv \
    PATH="/app/backend/.venv/bin:/usr/lib/postgresql/16/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MATERIALS_DIR=/app/docs/curriculum \
    UPLOAD_DIR=/data/uploads \
    HF_HOME=/data/hf \
    TRANSFORMERS_CACHE=/data/hf \
    HF_HUB_DISABLE_TELEMETRY=1 \
    TOKENIZERS_PARALLELISM=false \
    DOCLING_ARTIFACTS_PATH=/opt/docling-models \
    TORCHINDUCTOR_CACHE_DIR=/data/torchinductor

WORKDIR /app

COPY deploy/install-python.sh /tmp/install-python.sh
COPY backend/pyproject.toml backend/uv.lock /app/backend/
RUN --mount=type=cache,target=/root/.cache/uv \
    chmod +x /tmp/install-python.sh \
    && /tmp/install-python.sh deps

COPY backend /app/backend
COPY docs/curriculum /app/docs/curriculum
COPY deploy/migrate.sh deploy/api-entrypoint.sh deploy/db_ping.py /app/deploy/
RUN --mount=type=cache,target=/root/.cache/uv \
    chmod +x /app/deploy/migrate.sh /app/deploy/api-entrypoint.sh \
    && /tmp/install-python.sh project \
    && python -c "import torch; v=torch.__version__; assert '+cpu' in v, v; print('torch', v)" \
    && rm /tmp/install-python.sh

# Standard PDF pipeline weights (layout, tableformer, RapidOCR torch).
# Baked into the image, not /data/hf, so the hf_cache volume cannot hide them
# and the first upload does not download models.
COPY deploy/prefetch_docling_models.py /tmp/prefetch_docling_models.py
RUN python /tmp/prefetch_docling_models.py \
    && rm /tmp/prefetch_docling_models.py

WORKDIR /app/backend
EXPOSE 8000
ENTRYPOINT ["/app/deploy/api-entrypoint.sh"]
