# Shared site block. The VM Caddyfile attaches this to {$DOMAIN} (HTTPS).
# The tunnel Caddyfile attaches it to :80 (HTTP). Cloudflare terminates TLS
# in tunnel mode, so this block does not request a certificate.

(site) {
	encode zstd gzip

	handle /api/* {
		request_body {
			max_size 32MB
		}
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	handle /health* {
		reverse_proxy api:8000
	}

	handle /docs* {
		reverse_proxy api:8000
	}

	handle /openapi.json {
		reverse_proxy api:8000
	}

	handle /redoc {
		reverse_proxy api:8000
	}

	# The service worker and manifest must not sit in a long-lived edge cache.
	# nginx sets the same headers; these overwrite them if an upstream default differs.
	handle /sw.js {
		reverse_proxy web:80 {
			header_down Cache-Control "no-cache, max-age=0, must-revalidate"
			header_down Content-Type "application/javascript"
		}
	}

	handle /manifest.webmanifest {
		reverse_proxy web:80 {
			header_down Cache-Control "no-cache, max-age=0, must-revalidate"
			header_down Content-Type "application/manifest+json"
		}
	}

	handle {
		reverse_proxy web:80
	}
}
