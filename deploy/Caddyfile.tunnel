# Plain HTTP for Cloudflare Tunnel. The connector dials http://caddy:80.
# auto_https off keeps Caddy from trying ACME when the public name is random
# or when the hostname is only configured in Cloudflare.
{
	auto_https off
	servers {
		timeouts {
			read_body 300s
			write 300s
			idle 5m
		}
	}
}

import /etc/caddy/Caddyfile.site

:80 {
	import site
}
