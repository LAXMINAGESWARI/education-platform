# Public edge. DOMAIN and ACME_EMAIL come from the container environment.
# Same host serves the SPA and reverse-proxies the API, so the browser does
# not make a cross-origin call. Leave VITE_API_BASE_URL empty.
{
	email {$ACME_EMAIL}
	servers {
		timeouts {
			read_body 300s
			write 300s
			idle 5m
		}
	}
}

{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		request_body {
			max_size 32MB
		}
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	handle /health {
		reverse_proxy api:8000
	}

	handle /docs* {
		reverse_proxy api:8000
	}

	handle /openapi.json {
		reverse_proxy api:8000
	}

	handle /redoc {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:80
	}
}
