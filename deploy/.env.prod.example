# Copy to deploy/.env and replace every placeholder. Never commit deploy/.env.
# Passwords must be URL-safe: letters, digits, and hyphen. No spaces, quotes, or $.
#
# Compose builds DATABASE_URL for the containers:
#   postgresql+asyncpg://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB
# Do not point that URL at localhost.

ENVIRONMENT=production

# Public hostname. One GoDaddy A record. The site and the API share it.
DOMAIN=school.example.com
ACME_EMAIL=you@example.com

# Must mention https://DOMAIN. Same-origin browser calls do not need CORS;
# this keeps /docs and any absolute API origin aligned with the site.
CORS_ORIGINS=["https://school.example.com"]

POSTGRES_USER=education
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=education

# At least 32 characters. Used to sign JWT access and refresh tokens.
JWT_SECRET=replace-with-at-least-32-random-characters

# Read by Alembic when it creates the text_to_sql_reader role, and by the API.
TEXT_TO_SQL_DB_USER=text_to_sql_reader
TEXT_TO_SQL_DB_PASSWORD=replace-with-another-long-random-password

# Leave empty so the built SPA calls /api/v1 on the same host. Set a full
# https origin only if you rebuild the web image for a different API host.
VITE_API_BASE_URL=

# PC demo (./deploy/selfhost.sh). Empty token: a random https://*.trycloudflare.com
# URL, and the script allows that origin pattern. A token: named tunnel; set
# DOMAIN and include https://DOMAIN in CORS_ORIGINS. The VM deploy ignores this.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional. Empty keeps heuristic injection and stub summaries.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
ADK_MODEL=openrouter/openai/gpt-4o-mini

# true seeds the synthetic school once. always rebuilds it on the next deploy.
# false leaves the database to the curriculum seed the API runs when empty.
SEED_SYNTHETIC=true
SYNTHETIC_INSTITUTION=Al Noor International
SYNTHETIC_STUDENTS_PER_SECTION=24
# At least 2. The planted teacher is assigned to two sections of Grade 8 math.
SYNTHETIC_SECTIONS_PER_GRADE=2
SYNTHETIC_TERM_WEEKS=10
SYNTHETIC_SEED=20260812
