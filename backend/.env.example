ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Default: Compose Postgres (docker compose up -d postgres)
DATABASE_URL=postgresql+asyncpg://education:education@localhost:5432/education
JWT_SECRET=dev-only-change-me-use-32bytes-min!!
# Optional override; defaults to <repo>/docs/curriculum
# MATERIALS_DIR=/absolute/path/to/docs/curriculum
# UPLOAD_DIR=./var/uploads
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# MAX_UPLOAD_BYTES=20971520
# OpenRouter (required for live Policy assistant chat)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o-mini
# TypeSafe Jev replaces the GPT classifier inside the existing assistant guards.
# Separate from the lesson/item judge's JEV_MODEL and JEV_TIMEOUT_SECONDS.
# JEV_GUARD_MODEL=typesafe/jev-1.14
# JEV_GUARD_TIMEOUT_SECONDS=5
# JEV_BLOCK_THRESHOLD=0.85
# ADK_MODEL=openrouter/openai/gpt-4o-mini
# ADK_MAX_REVIEW_ROUNDS=4
# Blind solver. Default openai/gpt-4o. Keep it different from ADK_MODEL.
# BLIND_SOLVER_MODEL=openai/gpt-4o
# Jev decision model. Default shadow: scores are stored and the gate is unchanged.
# JEV_MODEL=typesafe/jev-1.14
# JEV_MODE=shadow  # off | shadow | augment | replace
# JEV_TIMEOUT_SECONDS=30
# JEV_MAX_RETRIES=2
# JEV_NOUL_ACCEPT=0.80
# JEV_NOUL_REJECT=0.35
# JEV_CONFIDENCE_ACCEPT=0.55
# JEV_CONFIDENCE_REJECT=0.70
# JEV_COVERAGE_ACCEPT_SCORE=2.0
# JEV_COVERAGE_REJECT_SCORE=0.75
# CHAT_CONTEXT_LIMIT_TOKENS=20000
# CHAT_RETRIEVAL_LIMIT=6
