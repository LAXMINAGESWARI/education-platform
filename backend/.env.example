ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Default: Compose Postgres (docker compose up -d postgres)
DATABASE_URL=postgresql+asyncpg://education:education@localhost:5432/education
# Readiness (GET /health and GET /health/ready) waits this many seconds for
# SELECT 1. Compose's healthcheck timeout is 5s; keep this lower. Default 2.
# HEALTH_READY_TIMEOUT_SECONDS=2
JWT_SECRET=dev-only-change-me-use-32bytes-min!!
# Optional override; defaults to <repo>/docs/curriculum
# MATERIALS_DIR=/absolute/path/to/docs/curriculum
# UPLOAD_DIR=./var/uploads
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# MAX_UPLOAD_BYTES=20971520
# OpenRouter (required for live Policy assistant chat)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o-mini
# TypeSafe Jev replaces the GPT classifier inside the existing assistant guards.
# The guard posts GUARD_JEV_MODEL when set, otherwise JEV_MODEL.
# JEV_GUARD_TIMEOUT_SECONDS stays at 5 so the guard does not inherit the
# judge's JEV_TIMEOUT_SECONDS (30). A missing key keeps the regex. HTTP 402
# falls back to that regex plus the previous GPT classifier.
# GUARD_JEV_MODEL=
# JEV_GUARD_TIMEOUT_SECONDS=5
# GUARD_JEV_BLOCK_THRESHOLD=0.6
# Refusal audits omit message text unless this is true.
# GUARD_AUDIT_STORE_PREVIEW=false
# LLM gateway. Leave unset in production until a feature is ready to migrate.
# AI_GATEWAY_FEATURES is a comma list, trimmed and case-insensitive.
# Jev Decisions calls are not chat completions. They stay on the Jev client
# and are not selected by these flags.
# AI_GATEWAY_POLICY_CHAT=false
# AI_GATEWAY_TEXT_TO_SQL=false
# AI_GATEWAY_GENERATION=false
# AI_GATEWAY_FEEDBACK=false
# AI_GATEWAY_FEATURES=policy_chat
# ADK_MODEL=openrouter/openai/gpt-4o-mini
# ADK_MAX_REVIEW_ROUNDS=4
# Blind solver. Default openai/gpt-4o. Keep it different from ADK_MODEL.
# BLIND_SOLVER_MODEL=openai/gpt-4o
# Jev decision model. Default shadow: scores are stored and the gate is unchanged.
# JEV_MODEL=typesafe/jev-1.14
# JEV_JUDGE_MODE=shadow  # off | shadow | enforce. enforce is an explicit opt-in.
# JEV_MODE is the previous name. When JEV_JUDGE_MODE is unset, only off and shadow apply.
# JEV_TIMEOUT_SECONDS=30
# JEV_MAX_RETRIES=2
# JEV_NOUL_ACCEPT=0.80
# JEV_NOUL_REJECT=0.35
# JEV_CONFIDENCE_ACCEPT=0.55
# JEV_CONFIDENCE_REJECT=0.70
# JEV_COVERAGE_ACCEPT_SCORE=2.0
# JEV_COVERAGE_REJECT_SCORE=0.75
# CHAT_CONTEXT_LIMIT_TOKENS=20000
# CHAT_RETRIEVAL_LIMIT=6
